generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  PAYMENT
  LOGIN
  ACCOUNT
  EXPENSE
  BUG
  FEATURE_REQUEST
  OTHER
}





model Ticket {
  id            String        @id @default(uuid())
  userId        String
  title         String
  description   String
  issueType     IssueType
  priority      Priority
  status        TicketStatus  @default(OPEN)
  assignedAgent String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  comments Comment[]
  history  TicketHistory[]
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

model TicketHistory {
  id          String        @id @default(uuid())
  ticketId    String
  oldStatus   TicketStatus?
  newStatus   TicketStatus
  changedBy   String
  createdAt   DateTime      @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

model FAQ {
  id         String   @id @default(uuid())
  question   String
  answer     String
  category   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}